<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:RoadEditor.UI"
             x:Class="RoadEditor.UI.MainPage"
             Title="Редактор Дорог">

    <Grid RowDefinitions="Auto, *" ColumnDefinitions="300, *">
        
        <!-- Toolbar -->
        <HorizontalStackLayout Grid.Row="0" Grid.ColumnSpan="2" BackgroundColor="#111111" Padding="10,5" Spacing="15">
            <Button Text="Очистить" Clicked="OnClearMapClicked" BackgroundColor="Transparent" TextColor="White" Padding="0" />
            <Button Text="Открыть" Clicked="OnLoadMapClicked" BackgroundColor="Transparent" TextColor="White" Padding="0" />
            <Button Text="Сохранить" Clicked="OnSaveMapClicked" BackgroundColor="Transparent" TextColor="White" Padding="0" />
            <Button Text="Размер" Clicked="OnResizeMapClicked" BackgroundColor="Transparent" TextColor="White" Padding="0" />
            <Button Text="Экспорт" Clicked="OnExportClicked" BackgroundColor="Transparent" TextColor="White" Padding="0" />

            <BoxView WidthRequest="1" Color="Gray" Margin="10,0" />
            <Button Clicked="OnZoomInClicked" Text="+" FontSize="18" TextColor="White" FontAttributes="Bold" WidthRequest="40" HeightRequest="30" Padding="0" BackgroundColor="#333" />
            <Button Clicked="OnZoomOutClicked" Text="-" FontSize="18" TextColor="White" FontAttributes="Bold" WidthRequest="40" HeightRequest="30" Padding="0" BackgroundColor="#333" />
        </HorizontalStackLayout>

        <!-- Sidebar (Tools) -->
        <Grid Grid.Row="1" Grid.Column="0" BackgroundColor="#1A0F33" Padding="15" RowDefinitions="Auto, Auto, Auto, Auto, Auto, *">
            
            <!-- Режимы работы -->
            <Label Text="Инструмент:" TextColor="White" FontAttributes="Bold" FontSize="16" Grid.Row="0" Margin="0,0,0,10" />
            <FlexLayout Grid.Row="1" Wrap="Wrap" JustifyContent="Start" Margin="0,0,0,20">
                <Button Clicked="OnToolModeClicked" CommandParameter="Navigate" Text="🖐" FontSize="20" TextColor="White" WidthRequest="50" HeightRequest="45" Margin="2" BackgroundColor="#333" CornerRadius="5" ToolTipProperties.Text="Навигация" />
                <Button Clicked="OnToolModeClicked" CommandParameter="DrawRect" Text="■" FontSize="20" TextColor="White" WidthRequest="50" HeightRequest="45" Margin="2" BackgroundColor="#5E35B1" CornerRadius="5" ToolTipProperties.Text="Область / Точка" />
                <Button Clicked="OnToolModeClicked" CommandParameter="DrawLine" Text="—" FontSize="20" TextColor="White" WidthRequest="50" HeightRequest="45" Margin="2" BackgroundColor="#333" CornerRadius="5" ToolTipProperties.Text="Линия" />
                <Button Clicked="OnToolModeClicked" CommandParameter="Eraser" Text="✕" FontSize="20" TextColor="White" WidthRequest="50" HeightRequest="45" Margin="2" BackgroundColor="#333" CornerRadius="5" ToolTipProperties.Text="Ластик" />
            </FlexLayout>

            <!-- Текущий элемент -->
            <Label Text="Тайл:" TextColor="White" FontAttributes="Bold" FontSize="16" Grid.Row="2" Margin="0,0,0,5" />
            <GraphicsView x:Name="PreviewGraphicsView" HeightRequest="100" WidthRequest="100" HorizontalOptions="Start"
                          Drawable="{Binding PreviewDrawable}" Grid.Row="3" BackgroundColor="Black" Margin="0,0,0,30" />
            
            <!-- Доступные элементы -->
            <Label Text="Палитра:" TextColor="White" FontAttributes="Bold" FontSize="16" Grid.Row="4" Margin="0,0,0,5" />
            
            <!-- Сетка элементов (кликабельная) -->
            <GraphicsView x:Name="PaletteGraphicsView" Grid.Row="5" HorizontalOptions="Start" VerticalOptions="Start"
                          WidthRequest="260" HeightRequest="260" BackgroundColor="Black"
                          Drawable="{Binding PaletteDrawable}"
                          EndInteraction="OnPaletteTapped" />

        </Grid>

        <!-- Map Area -->
        <ContentView Grid.Row="1" Grid.Column="1" BackgroundColor="#111111" Padding="20">
            <GraphicsView x:Name="MapGraphicsView"
                          Drawable="{Binding MapDrawable}"
                          Loaded="OnMapGraphicsViewLoaded"
                          StartInteraction="OnMapInteractionStarted"
                          DragInteraction="OnMapInteractionDragged"
                          EndInteraction="OnMapInteractionEnded">
                <GraphicsView.GestureRecognizers>
                    <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                    <PinchGestureRecognizer PinchUpdated="OnPinchUpdated" />
                </GraphicsView.GestureRecognizers>
            </GraphicsView>
        </ContentView>
        
    </Grid>

</ContentPage>
