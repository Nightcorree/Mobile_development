<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:RoadEditor.UI"
             x:Class="RoadEditor.UI.MainPage"
             Title="Road Editor">

    <Grid RowDefinitions="Auto, *, Auto" ColumnDefinitions="Auto, *">
        
        <!-- Toolbar -->
        <HorizontalStackLayout Grid.Row="0" Grid.ColumnSpan="2" BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray950}}" Padding="10" Spacing="10">
            <Button Text="New" Clicked="OnNewMapClicked" />
            <Button Text="Load" Clicked="OnLoadMapClicked" />
            <Button Text="Save" Clicked="OnSaveMapClicked" />
            <Button Text="Resize" Clicked="OnResizeMapClicked" />
        </HorizontalStackLayout>

        <!-- Sidebar (Tools) -->
        <VerticalStackLayout Grid.Row="1" Grid.Column="0" BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}" Padding="10" Spacing="5" WidthRequest="150">
            <Label Text="Инструменты" FontAttributes="Bold" HorizontalOptions="Center" />
            <Button Text="Empty" Clicked="OnToolSelected" CommandParameter="Empty" />
            <Button Text="Horizontal" Clicked="OnToolSelected" CommandParameter="RoadHorizontal" />
            <Button Text="Vertical" Clicked="OnToolSelected" CommandParameter="RoadVertical" />
            <Button Text="Crossroad" Clicked="OnToolSelected" CommandParameter="Crossroad" />
        </VerticalStackLayout>

        <!-- Map Area -->
        <ContentView Grid.Row="1" Grid.Column="1" BackgroundColor="White">
            <GraphicsView x:Name="MapGraphicsView"
                          Drawable="{Binding MapDrawable}"
                          EndInteraction="OnMapTapped">
                <GraphicsView.GestureRecognizers>
                    <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                </GraphicsView.GestureRecognizers>
            </GraphicsView>
        </ContentView>

        <!-- Status Bar -->
        <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Padding="5" BackgroundColor="#eee">
            <Label x:Name="StatusLabel" Text="Ready" VerticalOptions="Center" />
        </HorizontalStackLayout>
        
    </Grid>

</ContentPage>
