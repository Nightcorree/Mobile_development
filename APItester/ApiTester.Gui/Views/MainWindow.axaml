<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ApiTester.Gui.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ic="using:FluentIcons.Avalonia.Fluent"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="750"
        x:Class="ApiTester.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Mini-Postman (ApiTester)"
        Background="{DynamicResource SystemRegionBrush}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="TreeViewItem">
            <Setter Property="MinHeight" Value="32"/>
        </Style>
    </Window.Styles>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendRequestCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCurrentRequestCommand}" />
    </Window.KeyBindings>

    <Grid RowDefinitions="Auto, *">
        <!-- Top Toolbar -->
        <Border Grid.Row="0" 
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" 
                Padding="12,8" 
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" 
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ic:SymbolIcon Symbol="Send" FontSize="20" Foreground="{DynamicResource SystemAccentColor}"/>
                    <TextBlock Text="Mini-Postman" VerticalAlignment="Center" FontWeight="Bold" FontSize="16"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Окружение:" VerticalAlignment="Center" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <ComboBox ItemsSource="{Binding Environments}" SelectedItem="{Binding CurrentEnvironment}" Width="200">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}">
                                    <TextBlock.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Переименовать" 
                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RenameEnvironmentCommand}" 
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <ic:SymbolIcon Symbol="Edit" FontSize="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Удалить" 
                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveEnvironmentCommand}" 
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <ic:SymbolIcon Symbol="Delete" FontSize="16" Foreground="Red"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </TextBlock.ContextMenu>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Command="{Binding AddEnvironmentCommand}" ToolTip.Tip="Новое окружение" Padding="8,4">
                        <ic:SymbolIcon Symbol="Add" FontSize="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="300, 1, *">
            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto, Auto, Auto, *">
                    <Grid Grid.Row="0" ColumnDefinitions="*, *" Margin="12,12,12,0">
                        <Button Grid.Column="0" Command="{Binding AddRequestCommand}" 
                                HorizontalAlignment="Stretch" Classes="accent" Padding="0,8" Margin="0,0,5,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                <ic:SymbolIcon Symbol="Add" FontSize="16"/>
                                <TextBlock Text="Запрос"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Command="{Binding AddCollectionCommand}" 
                                HorizontalAlignment="Stretch" Padding="0,8" Margin="5,0,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                <ic:SymbolIcon Symbol="FolderAdd" FontSize="16"/>
                                <TextBlock Text="Коллекция"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Search Bar -->
                    <TextBox Grid.Row="1" Text="{Binding SearchQuery}" Watermark="Поиск..." Margin="12,10,12,0" Padding="8,5">
                        <TextBox.InnerLeftContent>
                            <ic:SymbolIcon Symbol="Search" FontSize="16" Margin="8,0,0,0" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    
                    <TreeView Grid.Row="3" ItemsSource="{Binding Collections}" 
                              SelectedItem="{Binding SelectedItem}"
                              Background="Transparent">
                        <TreeView.DataTemplates>
                            <TreeDataTemplate DataType="vm:CollectionViewModel" ItemsSource="{Binding Requests}">
                                <Grid ColumnDefinitions="Auto, *" Background="Transparent">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Переименовать" 
                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RenameCollectionCommand}" 
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <ic:SymbolIcon Symbol="Edit" FontSize="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Удалить" 
                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveCollectionCommand}" 
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <ic:SymbolIcon Symbol="Delete" FontSize="16" Foreground="Red"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <ic:SymbolIcon Grid.Column="0" Symbol="Folder" FontSize="16" Margin="0,0,8,0" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" 
                                             VerticalAlignment="Center" Padding="4,0" Margin="0"/>
                                </Grid>
                            </TreeDataTemplate>
                            <DataTemplate DataType="vm:RequestViewModel">
                                <Grid ColumnDefinitions="Auto, *" Margin="0,2" Background="Transparent">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Переименовать" 
                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RenameRequestCommand}" 
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <ic:SymbolIcon Symbol="Edit" FontSize="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Удалить" 
                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveRequestCommand}" 
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <ic:SymbolIcon Symbol="Delete" FontSize="16" Foreground="Red"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <TextBlock Grid.Column="0" Text="{Binding Method}" Width="40" FontSize="10" 
                                               VerticalAlignment="Center" FontWeight="Bold" 
                                               Foreground="{DynamicResource SystemAccentColor}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" 
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </TreeView.DataTemplates>
                    </TreeView>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Background="Transparent"/>

            <!-- Main Content -->
            <Grid Grid.Column="2" RowDefinitions="Auto, Auto, *" Margin="20">
                <!-- Name Row -->
                <TextBox Grid.Row="0" Text="{Binding RequestName}" Watermark="Название запроса" 
                         FontSize="18" FontWeight="SemiBold" BorderThickness="0" Background="Transparent" 
                         Margin="0,0,0,10" Padding="0"/>

                <!-- URL Bar -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto, Auto" Margin="0,0,0,20">
                    <ComboBox Grid.Column="0" ItemsSource="{Binding Methods}" SelectedItem="{Binding Method}" Width="100" Margin="0,0,10,0"/>
                    <Grid Grid.Column="1">
                        <TextBox Text="{Binding Url}" Watermark="Введите URL (https://...)" VerticalContentAlignment="Center" FontWeight="Medium" FontSize="14"/>
                        <ProgressBar IsVisible="{Binding IsLoading}" IsIndeterminate="True" Height="2" VerticalAlignment="Bottom" Background="Transparent" Foreground="{DynamicResource SystemAccentColor}"/>
                    </Grid>
                    <Button Grid.Column="2" Command="{Binding SaveCurrentRequestCommand}" Margin="10,0,0,0" ToolTip.Tip="Сохранить (Ctrl+S)" Padding="10,6">
                        <ic:SymbolIcon Symbol="Save" FontSize="18"/>
                    </Button>
                    <Button Grid.Column="3" Command="{Binding SendRequestCommand}" IsEnabled="{Binding !IsLoading}" Margin="10,0,0,0" ToolTip.Tip="Отправить (Ctrl+Enter)" Classes="accent" FontWeight="Bold" MinWidth="130" HorizontalContentAlignment="Center" Padding="15,6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ic:SymbolIcon Symbol="Send" FontSize="16"/>
                            <TextBlock Text="Отправить"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Tabs / Editors -->
                <Grid Grid.Row="2" RowDefinitions="2*, 4, 1*, Auto">
                    <TabControl Grid.Row="0">
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ic:SymbolIcon Symbol="Document" FontSize="14"/>
                                    <TextBlock Text="Тело"/>
                                </StackPanel>
                            </TabItem.Header>
                            <TextBox Text="{Binding RequestBody}" AcceptsReturn="True" Watermark="{}{ ... }" Margin="0,10,0,0" 
                                     FontFamily="Consolas,Monaco,Andale Mono,Ubuntu Mono,monospace"
                                     FontSize="13"/>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ic:SymbolIcon Symbol="List" FontSize="14"/>
                                    <TextBlock Text="Заголовки"/>
                                </StackPanel>
                            </TabItem.Header>
                            <Grid RowDefinitions="*, Auto" Margin="0,10,0,0">
                                <DataGrid Grid.Row="0" ItemsSource="{Binding Headers}" AutoGenerateColumns="False" CanUserResizeColumns="True" 
                                          BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="" Binding="{Binding IsEnabled}" Width="Auto"/>
                                        <DataGridTextColumn Header="Ключ" Binding="{Binding Key}" Width="*"/>
                                        <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="*"/>
                                        <DataGridTemplateColumn Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveHeaderCommand}" 
                                                            CommandParameter="{Binding}" Padding="8,4" Background="Transparent" Foreground="Red">
                                                        <ic:SymbolIcon Symbol="Delete" FontSize="16"/>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Grid.Row="1" Command="{Binding AddHeaderCommand}" Margin="0,8,0,0" HorizontalAlignment="Right" Padding="8,4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ic:SymbolIcon Symbol="Add" FontSize="14"/>
                                        <TextBlock Text="Добавить заголовок"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ic:SymbolIcon Symbol="Glance" FontSize="14"/>
                                    <TextBlock Text="Переменные"/>
                                </StackPanel>
                            </TabItem.Header>
                            <Grid RowDefinitions="Auto, *, Auto" Margin="0,10,0,0">
                                <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,15">
                                    <TextBlock Grid.Column="0" Text="Название окружения: " VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding CurrentEnvironment.Name}" Margin="10,0,10,0"/>
                                    <Button Grid.Column="2" Command="{Binding RemoveEnvironmentCommand}" 
                                            ToolTip.Tip="Удалить окружение" Background="Transparent" BorderThickness="0">
                                        <ic:SymbolIcon Symbol="Delete" FontSize="18" Foreground="Red"/>
                                    </Button>
                                </Grid>
                                <Grid Grid.Row="1" RowDefinitions="*, Auto">
                                    <DataGrid Grid.Row="0" ItemsSource="{Binding CurrentEnvironment.Variables}" AutoGenerateColumns="False"
                                              BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Ключ переменной" Binding="{Binding Key}" Width="*"/>
                                            <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="*"/>
                                            <DataGridTemplateColumn Width="Auto">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveVariableCommand}" 
                                                                CommandParameter="{Binding}" Padding="8,4" Background="Transparent" Foreground="Red">
                                                            <ic:SymbolIcon Symbol="Delete" FontSize="16"/>
                                                        </Button>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Button Grid.Row="1" Command="{Binding AddVariableCommand}" Margin="0,8,0,0" HorizontalAlignment="Right" Padding="8,4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ic:SymbolIcon Symbol="Add" FontSize="14"/>
                                            <TextBlock Text="Добавить переменную"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Button Grid.Row="2" Command="{Binding SaveEnvironmentsCommand}" Margin="0,12,0,0" HorizontalAlignment="Stretch" Classes="accent" Padding="12,8">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                        <ic:SymbolIcon Symbol="Save" FontSize="14"/>
                                        <TextBlock Text="Сохранить окружения"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <GridSplitter Grid.Row="1" Background="Transparent" Margin="0,5"/>

                    <!-- Response Section -->
                    <Grid Grid.Row="2" RowDefinitions="Auto, *">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,5,0,10" Spacing="8">
                            <ic:SymbolIcon Symbol="History" FontSize="16"/>
                            <TextBlock Text="Ответ" FontWeight="Bold" FontSize="14"/>
                        </StackPanel>
                        <TextBox Grid.Row="1" Text="{Binding ResponseText}" IsReadOnly="True" AcceptsReturn="True" 
                                 Watermark="Ответ появится здесь..." 
                                 FontFamily="Consolas,Monaco,Andale Mono,Ubuntu Mono,monospace"
                                 Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                 FontSize="13"/>
                    </Grid>

                    <!-- Status Bar -->
                    <Border Grid.Row="3" 
                            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" 
                            Padding="12,6" 
                            Margin="0,10,0,0" 
                            CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ic:SymbolIcon Symbol="Info" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>

</Window>
