<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ApiTester.Gui.Views.ConfirmDialog">
    <Border Padding="24" 
            Background="#1E1E1E" 
            BorderBrush="{DynamicResource SystemAccentColor}"
            BorderThickness="2"
            CornerRadius="12"
            BoxShadow="0 10 40 0 #A0000000">
        <StackPanel Spacing="20" Width="350">
            <TextBlock Text="Подтверждение" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentColor}"/>
            
            <TextBlock Name="MessageText" 
                       TextWrapping="Wrap" 
                       FontSize="15" 
                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,5,0,0">
                <Button Name="CancelButton" Content="Отмена" Width="100" HorizontalContentAlignment="Center" Padding="0,8"/>
                <Button Name="ConfirmButton" Content="Да" Width="100" HorizontalContentAlignment="Center" Padding="0,8" Classes="accent"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
