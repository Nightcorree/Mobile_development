<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ApiTester.Gui.Views.InputDialog"
             Width="350">
    <Border Padding="24" 
            Background="#1E1E1E" 
            BorderBrush="{DynamicResource SystemAccentColor}"
            BorderThickness="2"
            CornerRadius="12"
            BoxShadow="0 10 40 0 #A0000000">
        <StackPanel Spacing="15">
            <TextBlock Name="TitleText" Text="Введите название" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentColor}"/>
            
            <TextBox Name="InputTextBox" Watermark="Название..." VerticalContentAlignment="Center" Margin="0,5"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,10,0,0">
                <Button Name="CancelButton" Content="Отмена" Width="90" HorizontalContentAlignment="Center" Padding="0,8"/>
                <Button Name="ConfirmButton" Content="Сохранить" Width="110" HorizontalContentAlignment="Center" Classes="accent" Padding="0,8"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
